{
  "name": "cte-diff",
  "displayName": "CTE Diff for dbt",
  "description": "Preview any CTE's rows, and compare the same CTE on both sides of a diff, straight from the editor. Runs through dbt show, so Jinja, refs and your warehouse profile just work.",
  "version": "0.8.2",
  "publisher": "MarkPhamm",
  "author": "Minh (Mark) Pham",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/MarkPhamm/cte-diff"
  },
  "bugs": "https://github.com/MarkPhamm/cte-diff/issues",
  "homepage": "https://ctediff.dev/",
  "engines": {
    "vscode": "^1.85.0"
  },
  "galleryBanner": {
    "color": "#19211e",
    "theme": "dark"
  },
  "qna": "https://github.com/MarkPhamm/cte-diff/issues",
  "categories": [
    "Data Science",
    "Testing",
    "Other"
  ],
  "keywords": [
    "dbt",
    "bigquery",
    "duckdb",
    "redshift",
    "snowflake",
    "sql",
    "cte",
    "diff",
    "data diff",
    "row diff",
    "compare",
    "preview",
    "code review",
    "pull request",
    "jinja",
    "dbt-core",
    "dbt fusion",
    "analytics engineering",
    "data quality",
    "data testing",
    "regression testing",
    "warehouse"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:sql",
    "onLanguage:jinja-sql",
    "onLanguage:snowflake-sql"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Runs dbt, which runs the project's macros."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "cteDiff.preview",
        "title": "Preview CTE",
        "category": "CTE Diff"
      },
      {
        "command": "cteDiff.compare",
        "title": "Compare CTE on Both Sides",
        "category": "CTE Diff"
      },
      {
        "command": "cteDiff.compareCompiled",
        "title": "Compare Compiled SQL",
        "category": "CTE Diff",
        "icon": "$(code)"
      },
      {
        "command": "cteDiff.newComparison",
        "title": "New Comparison (Paste Two Queries)",
        "category": "CTE Diff",
        "icon": "$(diff)"
      },
      {
        "command": "cteDiff.compareFiles",
        "title": "Compare Two Files…",
        "category": "CTE Diff",
        "icon": "$(files)"
      },
      {
        "command": "cteDiff.compareWithBranch",
        "title": "Compare with Branch…",
        "category": "CTE Diff",
        "icon": "$(git-branch)"
      },
      {
        "command": "cteDiff.files.pick",
        "title": "Pick a File",
        "category": "CTE Diff"
      },
      {
        "command": "cteDiff.files.setOld",
        "title": "Use as Old",
        "category": "CTE Diff",
        "icon": "$(arrow-left)"
      },
      {
        "command": "cteDiff.files.setNew",
        "title": "Use as New",
        "category": "CTE Diff",
        "icon": "$(arrow-right)"
      },
      {
        "command": "cteDiff.files.open",
        "title": "Open the Diff",
        "category": "CTE Diff",
        "icon": "$(git-compare)"
      },
      {
        "command": "cteDiff.compareCte",
        "title": "Compare a CTE…",
        "category": "CTE Diff",
        "icon": "$(git-compare)"
      },
      {
        "command": "cteDiff.previewCte",
        "title": "Preview a CTE…",
        "category": "CTE Diff",
        "icon": "$(play)"
      },
      {
        "command": "cteDiff.rerun",
        "title": "Run Again",
        "category": "CTE Diff",
        "icon": "$(refresh)"
      },
      {
        "command": "cteDiff.showLog",
        "title": "Show Log",
        "category": "CTE Diff",
        "icon": "$(output)"
      },
      {
        "command": "cteDiff.tree.previewLeft",
        "title": "Preview Left (Old)",
        "category": "CTE Diff",
        "icon": "$(arrow-left)"
      },
      {
        "command": "cteDiff.tree.previewRight",
        "title": "Preview Right (New)",
        "category": "CTE Diff",
        "icon": "$(arrow-right)"
      },
      {
        "command": "cteDiff.tree.compare",
        "title": "Compare Both Sides",
        "category": "CTE Diff",
        "icon": "$(git-compare)"
      },
      {
        "command": "cteDiff.tree.preview",
        "title": "Preview",
        "category": "CTE Diff",
        "icon": "$(play)"
      },
      {
        "command": "cteDiff.tree.reveal",
        "title": "Go to CTE",
        "category": "CTE Diff"
      },
      {
        "command": "cteDiff.checkSetup",
        "title": "Check Setup",
        "category": "CTE Diff"
      },
      {
        "command": "cteDiff.chooseProject",
        "title": "Choose dbt Project",
        "category": "CTE Diff"
      }
    ],
    "walkthroughs": [
      {
        "id": "cteDiff.start",
        "title": "Get started with CTE Diff",
        "description": "See what a dbt change did to the data, one CTE at a time.",
        "steps": [
          {
            "id": "open",
            "title": "Open a change",
            "description": "Click a changed model in Source Control: its old and new versions open side by side, and the CTE Diff sidebar marks each CTE changed, new, removed or reads a changed CTE.\nNo git change? Compare two files, or paste two queries.\n[Open Source Control](command:workbench.view.scm)\n[Compare Two Files](command:cteDiff.compareFiles)\n[Paste Two Queries](command:cteDiff.newComparison)",
            "media": { "image": "docs/assets/img/sidebar.png", "altText": "The CTE Diff sidebar marking each CTE of a diff" },
            "completionEvents": ["onView:cteDiff.ctes"]
          },
          {
            "id": "lens",
            "title": "Show the buttons in diffs",
            "description": "Diff editors hide the ▶ Preview and ⇄ Compare sides buttons above each CTE unless \"diffEditor.codeLens\" is on. The sidebar and the editor's title bar have the same buttons either way.\n[Turn On diffEditor.codeLens](command:workbench.action.openSettings?%5B%22diffEditor.codeLens%22%5D)",
            "media": { "image": "docs/assets/img/preview.png", "altText": "▶ Preview above a CTE, and its rows in the CTE Diff panel" },
            "completionEvents": ["onSettingChanged:diffEditor.codeLens"]
          },
          {
            "id": "compare",
            "title": "Compare a CTE",
            "description": "Click ⇄ above a CTE, in the sidebar, or in the editor's title bar. dbt runs the CTE on both sides in one query, and the panel lists the rows only one side returns, with changed rows paired old above new.",
            "media": { "image": "docs/assets/img/compare.png", "altText": "A comparison: changed rows paired, with the changed cells highlighted" },
            "completionEvents": ["onCommand:cteDiff.compare", "onCommand:cteDiff.compareCte", "onCommand:cteDiff.tree.compare"]
          },
          {
            "id": "setup",
            "title": "If dbt fails, check the setup",
            "description": "Check Setup runs dbt debug with CTE Diff's settings and shows the dbt it found, the project and the target.\n[Check Setup](command:cteDiff.checkSetup)",
            "media": { "markdown": "media/walkthrough/setup.md" },
            "completionEvents": ["onCommand:cteDiff.checkSetup"]
          }
        ]
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "cteDiff.compareCte",
          "when": "isInDiffEditor && resourceLangId =~ /^(sql|jinja-sql|snowflake-sql)$/"
        },
        {
          "command": "cteDiff.compareCompiled",
          "when": "isInDiffEditor && resourceLangId =~ /^(sql|jinja-sql|snowflake-sql)$/"
        },
        {
          "command": "cteDiff.previewCte",
          "when": "!isInDiffEditor && resourceLangId =~ /^(sql|jinja-sql|snowflake-sql)$/"
        },
        {
          "command": "cteDiff.rerun",
          "when": "cteDiff.ran"
        },
        {
          "command": "cteDiff.preview",
          "when": "false"
        },
        {
          "command": "cteDiff.compare",
          "when": "false"
        },
        {
          "command": "cteDiff.tree.previewLeft",
          "when": "false"
        },
        {
          "command": "cteDiff.tree.previewRight",
          "when": "false"
        },
        {
          "command": "cteDiff.tree.compare",
          "when": "false"
        },
        {
          "command": "cteDiff.tree.preview",
          "when": "false"
        },
        {
          "command": "cteDiff.tree.reveal",
          "when": "false"
        },
        {
          "command": "cteDiff.files.pick",
          "when": "false"
        },
        {
          "command": "cteDiff.files.setOld",
          "when": "false"
        },
        {
          "command": "cteDiff.files.setNew",
          "when": "false"
        },
        {
          "command": "cteDiff.files.open",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "cteDiff.compareCte",
          "when": "isInDiffEditor && resourceLangId =~ /^(sql|jinja-sql|snowflake-sql)$/",
          "group": "navigation"
        },
        {
          "command": "cteDiff.compareCompiled",
          "when": "isInDiffEditor && resourceLangId =~ /^(sql|jinja-sql|snowflake-sql)$/",
          "group": "navigation"
        },
        {
          "command": "cteDiff.previewCte",
          "when": "!isInDiffEditor && resourceLangId =~ /^(sql|jinja-sql|snowflake-sql)$/",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "cteDiff.compareCompiled",
          "when": "view == cteDiff.ctes && cteDiff.inDiff",
          "group": "navigation"
        },
        {
          "command": "cteDiff.compareWithBranch",
          "when": "view == cteDiff.ctes",
          "group": "navigation"
        },
        {
          "command": "cteDiff.compareFiles",
          "when": "view == cteDiff.ctes",
          "group": "navigation"
        },
        {
          "command": "cteDiff.newComparison",
          "when": "view == cteDiff.ctes",
          "group": "navigation"
        },
        {
          "command": "cteDiff.rerun",
          "when": "view == cteDiff.results && cteDiff.ran",
          "group": "navigation@1"
        },
        {
          "command": "cteDiff.showLog",
          "when": "view == cteDiff.results",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "cteDiff.tree.previewLeft",
          "when": "view == cteDiff.ctes && viewItem =~ /\\bleft\\b/",
          "group": "inline@1"
        },
        {
          "command": "cteDiff.tree.previewRight",
          "when": "view == cteDiff.ctes && viewItem =~ /\\bright\\b/",
          "group": "inline@2"
        },
        {
          "command": "cteDiff.tree.compare",
          "when": "view == cteDiff.ctes && viewItem == 'left right'",
          "group": "inline@3"
        },
        {
          "command": "cteDiff.tree.preview",
          "when": "view == cteDiff.ctes && viewItem == single",
          "group": "inline@1"
        },
        {
          "command": "cteDiff.files.setOld",
          "when": "view == cteDiff.files && viewItem == sqlFile",
          "group": "inline@1"
        },
        {
          "command": "cteDiff.files.setNew",
          "when": "view == cteDiff.files && viewItem == sqlFile",
          "group": "inline@2"
        },
        {
          "command": "cteDiff.compareWithBranch",
          "when": "view == cteDiff.files && viewItem == sqlFile",
          "group": "inline@3"
        }
      ]
    },
    "configuration": {
      "title": "CTE Diff",
      "properties": {
        "cteDiff.dbtPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the `dbt` executable. Empty: the project's or workspace's `.venv`, then `~/.local/bin`, Homebrew, else `dbt` on `PATH`."
        },
        "cteDiff.projectDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "The dbt project to run queries in, relative to the workspace folder. Empty: the project holding the file, else the one in the workspace (asked once when there are several)."
        },
        "cteDiff.target": {
          "type": "string",
          "default": "",
          "markdownDescription": "The dbt target (`--target`). Empty: the profile's default."
        },
        "cteDiff.limit": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "description": "The most rows to fetch for a preview, and the most differing rows for a comparison."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cteDiff",
          "title": "CTE Diff",
          "icon": "media/activity.svg"
        }
      ],
      "panel": [
        {
          "id": "cteDiffResults",
          "title": "CTE Diff",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "cteDiff": [
        {
          "id": "cteDiff.ctes",
          "name": "CTEs",
          "icon": "media/activity.svg",
          "contextualTitle": "CTE Diff"
        },
        {
          "id": "cteDiff.files",
          "name": "Compare Files",
          "icon": "media/activity.svg",
          "contextualTitle": "CTE Diff"
        }
      ],
      "cteDiffResults": [
        {
          "type": "webview",
          "id": "cteDiff.results",
          "name": "Results"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "cteDiff.ctes",
        "contents": "Open a SQL file to list its CTEs. To see which CTEs changed and compare their rows, open two versions side by side, four ways:\nClick a changed model in Source Control. In the diff, Compare a CTE… is in the editor's title bar.\n[Compare with Branch…](command:cteDiff.compareWithBranch)\n[Compare Two Files…](command:cteDiff.compareFiles)\n[Paste Two Queries](command:cteDiff.newComparison)\nWhen dbt fails, [Check Setup](command:cteDiff.checkSetup) shows what dbt finds."
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "site:js": "node esbuild.mjs --site",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:integration": "node esbuild.mjs && node test/integration/run.mjs",
    "capture": "npm run package && node scripts/capture.ts",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "ovsx": "1.3.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3"
  }
}
